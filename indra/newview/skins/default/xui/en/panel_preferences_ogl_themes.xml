<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel border="true" follows="all" height="480" layout="topleft"
 left="1" top="1" width="540" label="OGL Designs" name="ogl_themes_panel">
    <text name="ogl_heading" left="22" top="18" right="-22" height="22" follows="left|right|top" layout="topleft" font="SansSerifLarge">
        OGL Designs
    </text>
    <text name="ogl_description" left="22" top="51" right="-22" height="34" follows="left|right|top" layout="topleft" font="SansSerifSmall">
        Optional color themes for chat and viewer windows.
        OGL Standard is the default. Classic compatibility remains optional.
    </text>
    <text name="ogl_theme_choose" left="22" top="111" right="-22" height="20" follows="left|right|top" layout="topleft" font="SansSerifSmallBold">
        Installed designs
    </text>
    <combo_box name="ogl_theme_combo" left="22" top="138" width="275" height="24"
     follows="left|top" layout="topleft" />
    <button name="ogl_theme_folder" left="308" top="138" width="181" height="24"
     follows="right|top" layout="topleft" label="Open theme folder" />
    <button name="ogl_theme_install" left="22" top="168" width="275" height="24"
     follows="left|top" layout="topleft" label="Install selected theme" />
    <button name="ogl_theme_select_file" left="308" top="168" width="181" height="24"
     follows="right|top" layout="topleft" label="Select .ogltheme" />
    <view_border name="ogl_theme_divider" bevel_style="in" follows="left|top"
     layout="topleft" left="22" top="199" width="467" height="1" />
    <text name="ogl_theme_preview_label" left="22" top="213" right="-22" height="21" follows="left|right|top" layout="topleft" font="SansSerifSmallBold">
        Color preview (does not change the viewer)
    </text>
    <panel name="ogl_theme_color_bg" left="22" top="246" height="39" width="143"
     background_visible="true" background_opaque="true" bg_opaque_color="Black"
     follows="left|top" layout="topleft" border="true" />
    <text name="ogl_theme_color_bg_label" left="22" top="289" height="18" width="143"
     follows="left|top" layout="topleft" halign="center" font="SansSerifSmall">Window</text>
    <panel name="ogl_theme_color_text" left="176" top="246" height="39" width="143"
     background_visible="true" background_opaque="true" bg_opaque_color="Black"
     follows="left|top" layout="topleft" border="true" />
    <text name="ogl_theme_color_text_label" left="176" top="289" height="18" width="143"
     follows="left|top" layout="topleft" halign="center" font="SansSerifSmall">Text</text>
    <panel name="ogl_theme_color_chat" left="330" top="246" height="39" width="143"
     background_visible="true" background_opaque="true" bg_opaque_color="Black"
     follows="left|top" layout="topleft" border="true" />
    <text name="ogl_theme_color_chat_label" left="330" top="289" height="18" width="143"
     follows="left|top" layout="topleft" halign="center" font="SansSerifSmall">Chat</text>
    <text name="ogl_theme_readonly_notice" left="22" top="320" right="-22" height="36" follows="left|right|top" layout="topleft" font="SansSerifSmall">
        Only local, unsigned, manifest-only color themes are supported.
        Install requires a separate click; activation changes your colors.
    </text>
    <button name="ogl_theme_activate" left="22" top="383" width="178" height="27"
     follows="left|top" layout="topleft" label="Activate design" />
    <button name="ogl_theme_reset" left="211" top="383" width="190" height="27"
     follows="left|top" layout="topleft" label="Restore original" />
    <button name="ogl_theme_remove" left="410" top="383" width="79" height="27"
     follows="right|top" layout="topleft" font="SansSerifSmall" label="Remove" />
    <text name="ogl_theme_status" left="22" top="432" right="-22" height="43" follows="left|right|top" layout="topleft" font="SansSerifSmall">
        Built-in OGL Standard is the default.
    </text>
    <string name="ogl_theme_default_name">OGL Standard (default)</string>
    <string name="ogl_status_loaded">Themes loaded. OGL Standard is the default.</string>
    <string name="ogl_status_invalid">Theme metadata invalid. Original design available.</string>
    <string name="ogl_status_preview">Preview only. Activate to save colors. Restart recommended.</string>
    <string name="ogl_status_invalid_preview">Invalid or removed theme. No changes applied.</string>
    <string name="ogl_status_activated">Theme activated. Restart Viewer for consistent UI colors.</string>
    <string name="ogl_status_activate_error">Theme activation refused. Check package/permissions.</string>
    <string name="ogl_status_reset">Original user palette restored. Restart recommended.</string>
    <string name="ogl_status_reset_error">Could not restore original palette; check user files.</string>
    <string name="ogl_status_folder">Install verified packages with the OGL theme manager.</string>
    <string name="ogl_status_folder_error">Could not open portable theme directory.</string>
    <string name="ogl_status_selected">Selected but not installed. Unsigned local theme: </string>
    <string name="ogl_status_installed">Color theme installed. Activate it separately to apply colors.</string>
    <string name="ogl_status_install_error">Theme refused: only a safe local theme.json is permitted.</string>
    <string name="ogl_status_removed">Inactive theme removed.</string>
    <string name="ogl_status_remove_error">Cannot remove active, default or modified theme; restore first.</string>
    <string name="ogl_status_selection_error">Only local, regular .ogltheme packages up to 16 MiB may be selected.</string>
</panel>
