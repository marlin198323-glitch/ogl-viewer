<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
     background_visible="true"
     bevel_style="in"
     bg_opaque_color="ChatHeaderOpaqueBackground"
     bg_alpha_color="ChatHeaderAlphaBackground"
     follows="top|left|right"
     height="34"
     label="im_header"
     layout="topleft"
     name="im_header"
     width="310">
    <layout_stack
     top="0"
     height="34"
     right="-84"
     name="header_ls"
     layout="topleft"
     orientation="horizontal"
     follows="top|left|right"
     animate="false">
        <layout_panel
         name="icon_lp"
         auto_resize="false"
         user_resize="false"
         width="32"
         height="34"
         visible="true">
            <avatar_icon
             circular="true"
             follows="left"
             height="26"
             image_name="Generic_Person"
             layout="topleft"
             left="3"
             mouse_opaque="true"
             name="avatar_icon"
             top="4"
             width="26" />
        </layout_panel>
        <layout_panel
         name="name_lp"
         auto_resize="true"
         user_resize="false"
         height="34">
            <text
             parse_urls="false"
             allow_scroll="false"
             v_pad="10"
             read_only="true"
             follows="left|right"
             font.style="BOLD"
             height="34"
             layout="topleft"
             left="8"
             right="-1"
             name="user_name"
             text_color="ChatNameColor"
             bg_readonly_color="Black"
             top="0"
             translate="false"
             use_ellipses="true"
             valign="top"
             value="" />
        </layout_panel>
    </layout_stack>
  <text
    allow_scroll="false"
    font="SansSerifSmall"
    follows="right"
    halign="right"
    use_ellipses="true"
    height="13"
    layout="topleft"
    left_pad="5"
    name="time_box"
    right="-8"
    top="11"
    value=""
    width="72" />
</panel>
