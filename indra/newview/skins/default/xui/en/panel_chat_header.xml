<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- NexVerse message row: REAL OpenSim avatar, name+time on top;
     message follows below in FSChatHistory. No fake profiles. -->
<panel
 background_visible="true"
 bevel_style="none"
 bg_opaque_color="OGLChatMessage"
 bg_alpha_color="OGLChatMessage"
 bg_opaque_image="Rounded_Rect"
 bg_alpha_image="Rounded_Rect"
 bg_opaque_image_overlay="OGLChatMessage"
 bg_alpha_image_overlay="OGLChatMessage"
 follows="top|left|right"
 height="42"
 label="im_header"
 layout="topleft"
 name="im_header"
 width="520">
    <layout_stack
     top="0"
     height="42"
     right="-115"
     name="header_ls"
     layout="topleft"
     orientation="horizontal"
     follows="top|left|right"
     animate="false">
        <layout_panel
         name="icon_lp"
         auto_resize="false"
         user_resize="false"
         width="44"
         height="42"
         visible="true">
            <avatar_icon
             follows="left|top"
             height="34"
             default_icon_name="Generic_Person"
             layout="topleft"
             left="5"
             mouse_opaque="true"
             name="avatar_icon"
             top="4"
             width="34" />
        </layout_panel>
        <layout_panel
         name="name_lp"
         auto_resize="true"
         user_resize="false"
         height="42">
            <text
             parse_urls="false"
             allow_scroll="false"
             v_pad="5"
             read_only="true"
             follows="left|right"
             font="SansSerif"
             font.style="BOLD"
             height="31"
             layout="topleft"
             left="4"
             right="-1"
             name="user_name"
             text_color="OGLChatAccent"
             bg_readonly_color="OGLChatMessage"
             top="5"
             translate="false"
             use_ellipses="true"
             valign="top"
             value="" />
        </layout_panel>
    </layout_stack>
    <text
     allow_scroll="false"
     font="SansSerifSmall"
     text_color="OGLChatTimestamp"
     follows="right|top"
     halign="right"
     height="22"
     layout="topleft"
     name="time_box"
     right="-8"
     top="8"
     value=""
     width="108" />
</panel>
