<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- All our XML is utf-8 encoded. -->
<panel
  name="instant_message"
  width="300"
  height="190"
  background_visible="true"
  bg_opaque_image="Rounded_Rect"
  bg_alpha_image="Rounded_Rect"
  bg_opaque_image_overlay="OGLChatMessage"
  bg_alpha_image_overlay="OGLChatMessage"
  follows="all">
     <avatar_icon
        follows="left|top"
        height="32"
        image_name="Generic_Person"
        layout="topleft"
        left="5"
        mouse_opaque="true"
        name="avatar_icon"
        top="4"
        width="32" />
	<text_chat
      top="3"
      left="49"
      right="-10"
      height="120"
      text_color="White"
      word_wrap="true"
      mouse_opaque="true"
      valign="top"
      name="msg_text">
	</text_chat>
</panel>
