<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- All our XML is utf-8 encoded. -->
<panel
  name="instant_message"
  width="300"
  height="180"
  follows="all">
     <avatar_icon circular="true"
        follows="left|top"
        height="26"
        image_name="Generic_Person"
        layout="topleft"
        left="3"
        mouse_opaque="true"
        name="avatar_icon"
        top="4"
        width="26" />
	<text_chat
      top="3"
      left="38"
      right="-8"
      height="120"
      text_color="ChatHistoryTextColor"
      word_wrap="true"
      mouse_opaque="true"
      valign="top"
      name="msg_text">
	</text_chat>
</panel>
