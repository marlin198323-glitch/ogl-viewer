<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel name="ogl_themes_panel" label="OGL Designs">
    <text name="ogl_heading">OGL-Designs</text>
    <text name="ogl_description">
        Optionale Farbdesigns für Chat und Viewer-Fenster.
        OGL Standard ist voreingestellt. Klassische Designs bleiben optional.
    </text>
    <text name="ogl_theme_choose">Installierte Designs</text>
    <button name="ogl_theme_folder" label="Designordner öffnen" />
    <button name="ogl_theme_select_file" label=".ogltheme auswählen" />
    <button name="ogl_theme_install" label="Design installieren" />
    <text name="ogl_theme_preview_label">Farbvorschau (ändert den Viewer nicht)</text>
    <text name="ogl_theme_color_bg_label">Fenster</text>
    <text name="ogl_theme_color_text_label">Text</text>
    <text name="ogl_theme_color_chat_label">Chat</text>
    <text name="ogl_theme_readonly_notice">
        Nur lokale, unsignierte Farbdesigns ohne Programmcode.
        Installation und Aktivierung benötigen getrennte Klicks.
    </text>
    <button name="ogl_theme_activate" label="Design aktivieren" />
    <button name="ogl_theme_reset" label="Original wiederherstellen" />
    <button name="ogl_theme_remove" label="Entfernen" />
    <text name="ogl_theme_status">
        OGL Standard ist voreingestellt.
    </text>
    <string name="ogl_theme_default_name">OGL Standard (Voreinstellung)</string>
    <string name="ogl_status_loaded">Designs geladen. OGL Standard ist voreingestellt.</string>
    <string name="ogl_status_invalid">Ungültige Designdaten. Original verfügbar.</string>
    <string name="ogl_status_preview">Nur Vorschau. Zum Speichern aktivieren. Neustart empfohlen.</string>
    <string name="ogl_status_invalid_preview">Ungültiges oder entferntes Design. Nichts geändert.</string>
    <string name="ogl_status_activated">Design aktiviert. Neustart empfohlen.</string>
    <string name="ogl_status_activate_error">Aktivierung abgelehnt. Datei und Berechtigungen prüfen.</string>
    <string name="ogl_status_reset">Original-Farben wiederhergestellt. Neustart empfohlen.</string>
    <string name="ogl_status_reset_error">Originalfarben konnten nicht wiederhergestellt werden.</string>
    <string name="ogl_status_folder">Geprüfte Pakete über den OGL-Theme-Manager installieren.</string>
    <string name="ogl_status_folder_error">Designordner konnte nicht geöffnet werden.</string>
    <string name="ogl_status_selected">Ausgewählt, nicht installiert. Unsigniertes lokales Design: </string>
    <string name="ogl_status_installed">Farbdesign installiert. Farben werden erst mit „Aktivieren“ angewendet.</string>
    <string name="ogl_status_install_error">Design abgelehnt: nur sicheres lokales theme.json ist zulässig.</string>
    <string name="ogl_status_removed">Inaktives Design entfernt.</string>
    <string name="ogl_status_remove_error">Aktives, verändertes oder Standarddesign kann nicht entfernt werden.</string>
    <string name="ogl_status_selection_error">Nur lokale reguläre .ogltheme-Dateien bis 16 MiB auswählbar.</string>
</panel>
