# Shared native CPU buffer target for Linux, Windows and macOS.
set(OGL_CPU_BUFFER_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(ogl_add_cpu_buffer_target target)
    add_library(${target} STATIC "${OGL_CPU_BUFFER_SOURCE_DIR}/buffer_dispatch.cpp")
    get_filename_component(OGL_CPU_INCLUDE_DIR
        "${OGL_CPU_BUFFER_SOURCE_DIR}/../include" ABSOLUTE)
    target_include_directories(${target} PUBLIC "${OGL_CPU_INCLUDE_DIR}")
    target_compile_features(${target} PRIVATE cxx_std_17)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND
       CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i[3-6]86)$")
        target_compile_options(${target} PRIVATE -march=x86-64)
    endif()
    set(OGL_CPU_SINGLE_ARCH TRUE)
    if(APPLE AND CMAKE_OSX_ARCHITECTURES)
        list(LENGTH CMAKE_OSX_ARCHITECTURES OGL_MAC_ARCH_COUNT)
        if(OGL_MAC_ARCH_COUNT GREATER 1)
            set(OGL_CPU_SINGLE_ARCH FALSE)
        endif()
    endif()
    if(OGL_CPU_SINGLE_ARCH AND
       CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64|i[3-6]86)$")
        include(CheckCXXCompilerFlag)
        if(MSVC)
            check_cxx_compiler_flag("/arch:AVX2" OGL_HAVE_AVX2_FLAG)
            if(OGL_HAVE_AVX2_FLAG)
                set_source_files_properties("${OGL_CPU_BUFFER_SOURCE_DIR}/buffer_avx2.cpp"
                    PROPERTIES COMPILE_OPTIONS "/arch:AVX2")
            endif()
        else()
            check_cxx_compiler_flag("-mavx2" OGL_HAVE_AVX2_FLAG)
            if(OGL_HAVE_AVX2_FLAG)
                set_source_files_properties("${OGL_CPU_BUFFER_SOURCE_DIR}/buffer_avx2.cpp"
                    PROPERTIES COMPILE_OPTIONS "-mavx2")
            endif()
        endif()
        if(OGL_HAVE_AVX2_FLAG)
            target_sources(${target} PRIVATE "${OGL_CPU_BUFFER_SOURCE_DIR}/buffer_avx2.cpp")
            target_compile_definitions(${target} PRIVATE OGL_WITH_AVX2=1)
        endif()
    elseif(OGL_CPU_SINGLE_ARCH AND
           CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
        include(CheckIncludeFileCXX)
        check_include_file_cxx("arm_neon.h" OGL_HAVE_ARM_NEON_HEADER)
        if(OGL_HAVE_ARM_NEON_HEADER)
            target_sources(${target} PRIVATE "${OGL_CPU_BUFFER_SOURCE_DIR}/buffer_neon.cpp")
            target_compile_definitions(${target} PRIVATE OGL_WITH_NEON=1)
        endif()
    endif()
endfunction()
